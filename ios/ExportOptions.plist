<?xml version="1.0" encoding="UTF-8"?>
<!--
  How the release workflow exports the iOS archive.

  `app-store-connect` is the only destination this project has: TestFlight
  and the App Store. `uploadSymbols` on, because a crash report without
  symbols names no line of anybody's code, and this app has one maintainer
  who will be reading them a year after writing them.

  `signingStyle` is automatic: the workflow installs one distribution
  certificate and one App Store profile into a throwaway keychain, so there
  is exactly one valid choice and naming it by hand would only be another
  string to keep in step with Apple's console.
-->
<plist version="1.0">
<dict>
  <key>method</key>
  <string>app-store-connect</string>
  <key>signingStyle</key>
  <string>automatic</string>
  <key>uploadSymbols</key>
  <true/>
  <key>destination</key>
  <string>export</string>
</dict>
</plist>
