{
  "name": "gen-con-trip",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Trip planner for the Gen Con convention: real map of the venues with the event schedule attached to rooms.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsx scripts/build-pack.mjs && vite build",
    "build:pack": "tsx scripts/build-pack.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "check:geometry": "node scripts/check-geometry.mjs",
    "plans:venues": "node scripts/venue-plans.mjs",
    "plans:campus": "node scripts/gencon-tiles.mjs",
    "fetch:events": "tsx scripts/fetch-events.mjs",
    "fetch:events:mirror": "tsx scripts/fetch-events-eventdb.mjs",
    "fetch:pavements": "node scripts/fetch-pavements.mjs",
    "fetch:exhibitors": "node scripts/fetch-exhibitors.mjs",
    "data:distances": "node scripts/build-distances.mjs",
    "events:sample": "node scripts/make-sample-events.mjs",
    "build:pages": "npm run fetch:events && npm run build",
    "fetch:eateries": "node scripts/fetch-eateries.mjs",
    "season:check": "tsx scripts/season/check.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "node-html-parser": "^9.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
