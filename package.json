{
  "name": "gen-con-trip",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Trip planner for the Gen Con convention: real map of the venues with the event schedule attached to rooms.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fetch:events": "node scripts/fetch-events.mjs",
    "events:sample": "node scripts/make-sample-events.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "node-html-parser": "^9.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
